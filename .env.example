# PARAKH Environment Configuration

APP_NAME="PARAKH"
APP_ENV="development"
DEBUG=True

# Storage
MAX_UPLOAD_SIZE_MB=15
AUDIO_RETENTION_ENABLED=false

# Database
DATABASE_URL="sqlite:///./parakh.db"

# LLM Provider Configuration
# Choose "gemini" for Google Gemini Free Tier, or "mock" for deterministic offline development
LLM_PROVIDER="gemini"

# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
LLM_TIMEOUT_SECONDS=40

# Speech-to-Text Configuration
# Choose "faster-whisper" for local transcription, or "mock" for instant development
STT_PROVIDER="faster-whisper"
WHISPER_MODEL_SIZE="tiny"

# Adaptive Engine Scoring Thresholds
DIFFICULTY_SATISFACTORY_THRESHOLD=70.0
DIFFICULTY_UNSATISFACTORY_THRESHOLD=50.0
CONFIDENCE_MIN_RELIABLE_THRESHOLD=0.65

# Camera / Privacy
ENABLE_VISION=false
